{
  "schemaVersion": 1,
  "id": "customizable-title-screen",
  "version": "${version}",
  "name": "Customizable Title Screen",
  "description": "Use a local background and visually arrange the Minecraft title screen.",
  "authors": ["Customizable Title Screen contributors"],
  "contact": {
    "sources": "https://github.com/tiraaamisuuu/customizable-title-screen",
    "issues": "https://github.com/tiraaamisuuu/customizable-title-screen/issues"
  },
  "license": "MIT",
  "icon": "assets/customizable-title-screen/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.customtitle.CustomTitleClient"],
    "modmenu": ["dev.customtitle.integration.CustomTitleModMenu"]
  },
  "mixins": [
    {
      "config": "customizable-title-screen.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=20.0.0"
  }
}
